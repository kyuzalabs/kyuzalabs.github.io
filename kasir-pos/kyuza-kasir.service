[Unit]
Description=Kyuza Kasir (POS warung makan & cafe)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/agentuser/github-projects/kasir-pos
EnvironmentFile=/home/agentuser/github-projects/kasir-pos/kasir.env
ExecStart=/home/agentuser/github-projects/kasir-pos/.venv/bin/gunicorn --preload -w 2 --threads 4 -b 0.0.0.0:8501 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target