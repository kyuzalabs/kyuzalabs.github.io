[Unit]
Description=Kyuza server health dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentuser
WorkingDirectory=/home/agentuser/github-projects/dashboard
ExecStart=/usr/bin/python3 /home/agentuser/github-projects/dashboard/server_dashboard.py --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target